# Runtime is local-only. Explicit package/model downloads are separate setup steps.
MODEL_PATH=D:\HCL\models\Qwen3.5-0.8B
LLM_PROVIDER=transformers
DB_PATH=data/copilot.db
MAX_NEW_TOKENS=400
GENERATION_TIMEOUT=300
# Windows workaround for safetensors mapping error 1455; loading has a higher transient RAM peak.
MODEL_DISABLE_MMAP=1
# Optional AVX2 CPU mode: dynamic int8 Linear layers, float32 activations, no new dependencies.
MODEL_CPU_INT8=0
TORCH_THREADS=4
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
