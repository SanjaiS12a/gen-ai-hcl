# Runtime is local-only. Explicit package/model downloads are separate setup steps.
MODEL_PATH=D:\HCL\models\Qwen3.5-0.8B-GGUF\Qwen3.5-0.8B-Q8_0.gguf
LLM_PROVIDER=llamacpp
LLAMA_SERVER_PATH=D:\HCL\tools\llama-b11755\llama-server.exe
LLAMA_PORT=8081
LLAMA_THREADS=4
LLAMA_BATCH_THREADS=8
DB_PATH=data/copilot.db
MAX_NEW_TOKENS=300
GENERATION_TIMEOUT=90
# The settings below apply only to the optional transformers provider.
# For that provider, MODEL_PATH must be the original safetensors directory.
# Windows workaround for safetensors mapping error 1455; loading has a higher transient RAM peak.
MODEL_DISABLE_MMAP=1
# Optional AVX2 CPU mode: dynamic int8 Linear layers, float32 activations, no new dependencies.
MODEL_CPU_INT8=0
TORCH_THREADS=4
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
